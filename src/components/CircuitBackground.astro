---
// Deterministic PRNG so the generated circuit layout stays stable across rebuilds.
function mulberry32(seed: number) {
	return function () {
		seed |= 0;
		seed = (seed + 0x6d2b79f5) | 0;
		let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
		t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
		return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
	};
}

const rand = mulberry32(42);
const W = 1600;
const H = 700;
const stepX = 100;
const stepY = 90;
const cols = Math.floor(W / stepX);
const rows = Math.floor(H / stepY);

function gridPoint(c: number, r: number): [number, number] {
	return [c * stepX + stepX / 2, r * stepY + stepY / 2];
}

const traces: { d: string; dur: string; delay: string }[] = [];
const pads: [number, number][] = [];

const TRACE_COUNT = 26;
for (let i = 0; i < TRACE_COUNT; i++) {
	let [x, y] = gridPoint(Math.floor(rand() * cols), Math.floor(rand() * rows));
	let d = `M${x} ${y}`;
	pads.push([x, y]);

	let horizontal = rand() > 0.5;
	const segments = 2 + Math.floor(rand() * 3);
	for (let s = 0; s < segments; s++) {
		const dist = (1 + Math.floor(rand() * 3)) * (horizontal ? stepX : stepY);
		const dir = rand() > 0.5 ? 1 : -1;
		if (horizontal) {
			x = Math.min(Math.max(x + dir * dist, 20), W - 20);
		} else {
			y = Math.min(Math.max(y + dir * dist, 20), H - 20);
		}
		d += ` L${x} ${y}`;
		pads.push([x, y]);
		horizontal = !horizontal;
	}

	traces.push({
		d,
		dur: `${(7 + rand() * 6).toFixed(1)}s`,
		delay: `${(-(rand() * 10)).toFixed(1)}s`,
	});
}

const CHIP_COUNT = 5;
const chips: { x: number; y: number; w: number; h: number }[] = [];
for (let i = 0; i < CHIP_COUNT; i++) {
	const [px, py] = pads[Math.floor(rand() * pads.length)];
	const w = 50 + Math.floor(rand() * 30);
	const h = 36 + Math.floor(rand() * 24);
	chips.push({ x: px - w / 2, y: py - h / 2, w, h });
}
---

<div class="circuit-bg absolute inset-0 overflow-hidden pointer-events-none" aria-hidden="true">
	<svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMid slice" class="w-full h-full">
		<defs>
			<filter id="circuit-glow" x="-300%" y="-300%" width="700%" height="700%">
				<feGaussianBlur stdDeviation="3.5" result="blur" />
				<feMerge>
					<feMergeNode in="blur" />
					<feMergeNode in="SourceGraphic" />
				</feMerge>
			</filter>
			<filter id="chip-glow" x="-150%" y="-150%" width="400%" height="400%">
				<feGaussianBlur stdDeviation="3" result="blur" />
				<feMerge>
					<feMergeNode in="blur" />
					<feMergeNode in="SourceGraphic" />
				</feMerge>
			</filter>
		</defs>

		{traces.map((t) => <path d={t.d} fill="none" stroke="var(--color-border)" stroke-width="1.25" opacity="0.5" />)}

		{
			pads.map(([x, y]) => (
				<circle cx={x} cy={y} r="3" fill="var(--color-bg-raised)" stroke="var(--color-border-strong)" stroke-width="1" />
			))
		}

		{
			chips.map((c) => (
				<rect
					x={c.x}
					y={c.y}
					width={c.w}
					height={c.h}
					rx="3"
					fill="var(--color-bg-raised)"
					stroke="var(--color-accent)"
					stroke-width="1.25"
					filter="url(#chip-glow)"
					class="chip-pulse"
				/>
			))
		}

		{
			traces.map((t, i) => (
				<path
					d={t.d}
					fill="none"
					stroke={i % 2 === 0 ? 'var(--color-accent)' : 'var(--color-accent-hover)'}
					stroke-width="2"
					stroke-linecap="round"
					filter="url(#circuit-glow)"
					class="trace-flow"
					style={`--dur:${t.dur}; --delay:${t.delay};`}
				/>
			))
		}
	</svg>

	<div class="circuit-fade absolute inset-0"></div>
</div>

<style>
	.circuit-bg svg {
		opacity: 0.7;
	}

	.trace-flow {
		stroke-dasharray: 22 90;
		stroke-dashoffset: 1000;
		animation: dash-flow var(--dur, 9s) linear infinite;
		animation-delay: var(--delay, 0s);
	}

	.chip-pulse {
		animation: chip-glow 4s ease-in-out infinite;
	}

	@keyframes dash-flow {
		to {
			stroke-dashoffset: 0;
		}
	}

	@keyframes chip-glow {
		0%,
		100% {
			stroke-opacity: 0.35;
		}
		50% {
			stroke-opacity: 0.95;
		}
	}

	.circuit-fade {
		background: linear-gradient(to right, var(--color-bg) 0%, color-mix(in srgb, var(--color-bg) 50%, transparent) 30%, transparent 55%);
	}

	@media (prefers-reduced-motion: reduce) {
		.trace-flow,
		.chip-pulse {
			animation: none;
		}
	}
</style>
