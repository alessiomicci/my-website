---
import { getCollection } from 'astro:content';
import ProjectCard from './ProjectCard.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const featured = projects.filter((entry) => entry.data.featured);
---

<section id="work" class="max-w-3xl mx-auto px-6 py-24 md:py-32 border-t border-border">
	<h2 class="text-2xl md:text-3xl font-semibold mb-2" data-animate-item>Selected Work</h2>
	<p class="text-text-secondary mb-12 max-w-lg" data-animate-item>A selection of professional and personal projects. Some client work is private; descriptions focus on responsibilities and outcomes.</p>
	<div class="flex flex-col gap-6">
		{featured.map((entry) => <ProjectCard entry={entry} />)}
	</div>
</section>
