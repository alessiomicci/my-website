---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';

interface Props {
	entry: CollectionEntry<'projects'>;
}

const { entry } = Astro.props;
const { title, role, order, stack, websiteUrl, githubUrl, appStoreUrl, playStoreUrl } = entry.data;
const index = String(order).padStart(2, '0');
const { Content } = await render(entry);
---

<article
	class="border border-border rounded-lg p-6 md:p-8 bg-bg-raised hover:border-border-strong transition-colors duration-200"
	data-animate-item
>
	<div class="flex items-baseline gap-3 mb-1">
		<span class="font-mono text-sm text-text-muted">{index}</span>
		<h3 class="text-xl font-semibold">{title}</h3>
	</div>
	<p class="text-text-secondary mb-4">{role}</p>

	<div class="flex flex-wrap gap-2 mb-4">
		{
			stack.map((item) => (
				<span class="font-mono text-sm text-text-muted border border-border rounded-sm px-2 py-1">
					{item}
				</span>
			))
		}
	</div>

	{
		(websiteUrl || githubUrl || appStoreUrl || playStoreUrl) && (
			<div class="flex flex-wrap gap-4 mb-6 font-mono text-xs">
				{websiteUrl && (
					<a
						href={websiteUrl}
						target="_blank"
						rel="noopener noreferrer"
						class="text-accent hover:text-accent-hover transition-colors duration-150"
					>
						Website →
					</a>
				)}
				{githubUrl && (
					<a
						href={githubUrl}
						target="_blank"
						rel="noopener noreferrer"
						class="text-accent hover:text-accent-hover transition-colors duration-150"
					>
						Source on GitHub →
					</a>
				)}
				{appStoreUrl && (
					<a
						href={appStoreUrl}
						target="_blank"
						rel="noopener noreferrer"
						class="text-accent hover:text-accent-hover transition-colors duration-150"
					>
						App Store →
					</a>
				)}
				{playStoreUrl && (
					<a
						href={playStoreUrl}
						target="_blank"
						rel="noopener noreferrer"
						class="text-accent hover:text-accent-hover transition-colors duration-150"
					>
						Google Play →
					</a>
				)}
			</div>
		)
	}

	<div class="border-t border-border pt-6 text-text-secondary text-sm leading-relaxed [&>p]:mb-3 [&>p:last-child]:mb-0">
		<Content />
	</div>
</article>
