---
const items = [
	{
		label: 'Docker',
		desc: 'Ambienti locali allineati a produzione, onboarding riproducibile in minuti.',
	},
	{
		label: 'Git-Flow',
		desc: 'Branching disciplinato, code review e pipeline di rilascio controllate.',
	},
	{
		label: 'Shell Scripting',
		desc: 'Automazione di build, deploy e task ricorrenti via script di sistema.',
	},
	{
		label: 'AI-Driven Workflows',
		desc: "Claude Code e automazione IDE per azzerare il boilerplate e accelerare l'iterazione.",
	},
	{
		label: 'Performance & SEO tecnica',
		desc: 'Core Web Vitals, rendering ottimizzato, markup semantico e accessibile.',
	},
];
---

<section class="max-w-3xl mx-auto px-6 py-24 md:py-32 border-t border-border">
	<h2 class="text-2xl md:text-3xl font-semibold mb-12" data-animate-item>Metodo di Lavoro</h2>
	<dl class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-8">
		{
			items.map((item) => (
				<div data-animate-item>
					<dt class="font-mono text-accent mb-1">&gt; {item.label}</dt>
					<dd class="text-text-secondary text-sm">{item.desc}</dd>
				</div>
			))
		}
	</dl>
</section>
