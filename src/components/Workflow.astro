---
const items = [
	{
		label: 'Docker',
		desc: 'Local environments aligned with production, reproducible onboarding in minutes.',
	},
	{
		label: 'Git-Flow',
		desc: 'Disciplined branching, code review, and controlled release pipelines.',
	},
	{
		label: 'Shell Scripting',
		desc: 'Automating builds, deployments, and recurring tasks via system scripts.',
	},
	{
		label: 'AI-Driven Workflows',
		desc: "Claude Code and IDE automation to eliminate boilerplate and speed up iteration.",
	},
	{
		label: 'Performance & Technical SEO',
		desc: 'Core Web Vitals, optimized rendering, semantic and accessible markup.',
	},
];
---

<section class="max-w-3xl mx-auto px-6 py-24 md:py-32 border-t border-border">
	<h2 class="text-2xl md:text-3xl font-semibold mb-12" data-animate-item>Working Method</h2>
	<dl class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-8">
		{
			items.map((item) => (
				<div data-animate-item>
					<dt class="font-mono text-accent mb-1">&gt; {item.label}</dt>
					<dd class="text-text-secondary text-sm">{item.desc}</dd>
				</div>
			))
		}
	</dl>
</section>
