---
const items = [
{ label: '01 / Discover & clarify', desc: 'I start with client conversations, business requirements and constraints. Structured AI-assisted interviews help surface assumptions, edge cases and open questions before implementation.' },
{ label: '02 / Build shared context', desc: 'I maintain evolving product documentation, architecture decisions, feature status and meeting summaries alongside code, so agents work with consistent project knowledge.' },
{ label: '03 / Implement incrementally', desc: 'I guide AI coding agents one feature at a time across relevant repositories, reviewing technical choices and keeping implementation aligned with requirements.' },
{ label: '04 / Verify & maintain', desc: 'I check delivered behavior, investigate issues and use AI-assisted code reviews. I remain responsible for understanding the system and its maintainability in production.' },
];
---

<section id="method" class="max-w-3xl mx-auto px-6 py-24 md:py-32 border-t border-border">
	<h2 class="text-2xl md:text-3xl font-semibold mb-12" data-animate-item>How I Build Software</h2>
	<dl class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-8">
		{
			items.map((item) => (
				<div data-animate-item>
					<dt class="font-mono text-accent mb-1">&gt; {item.label}</dt>
					<dd class="text-text-secondary text-sm">{item.desc}</dd>
				</div>
			))
		}
	</dl>
</section>
