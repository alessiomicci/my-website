---
import CircuitBackground from './CircuitBackground.astro';

const stack = [
	{ name: 'Laravel', color: '#FF2D20' },
	{ name: 'React', color: '#61DAFB' },
	{ name: 'Astro', color: '#FF5D01' },
	{ name: 'MySQL', color: '#4479A1' },
	{ name: 'AWS', color: '#FF9900' },
];

const socials = [
	{
		label: 'GitHub',
		href: 'https://github.com/alessiomicci',
		icon: 'M12 .5C5.73.5.5 5.73.5 12c0 5.09 3.29 9.4 7.86 10.93.57.1.78-.25.78-.55 0-.27-.01-1.17-.02-2.12-3.2.7-3.88-1.36-3.88-1.36-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.71.08-.71 1.17.08 1.78 1.2 1.78 1.2 1.03 1.77 2.71 1.26 3.37.96.1-.75.4-1.26.73-1.55-2.55-.29-5.23-1.28-5.23-5.68 0-1.25.45-2.28 1.19-3.08-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11.1 11.1 0 0 1 5.79 0c2.2-1.49 3.17-1.18 3.17-1.18.64 1.59.24 2.76.12 3.05.74.8 1.18 1.83 1.18 3.08 0 4.41-2.69 5.38-5.25 5.67.41.36.78 1.07.78 2.15 0 1.55-.01 2.8-.01 3.18 0 .3.2.66.79.55A10.52 10.52 0 0 0 23.5 12C23.5 5.73 18.27.5 12 .5Z',
	},
	{
		label: 'LinkedIn',
		href: 'https://www.linkedin.com/in/alessio-micci-8a4016375/',
		icon: 'M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.03-1.85-3.03-1.85 0-2.14 1.45-2.14 2.94v5.66H9.34V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.38-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.07 2.07 0 1 1 0-4.13 2.07 2.07 0 0 1 0 4.13ZM7.12 20.45H3.56V9h3.56v11.45Z',
	},
];
---

<section class="relative overflow-hidden w-full min-h-[85vh] flex flex-col justify-center px-6 py-24">
	<CircuitBackground />

	<div class="relative z-10 max-w-3xl mx-auto w-full">
		<h1 class="text-4xl md:text-6xl font-semibold mb-2" data-animate-item>Alessio Micci</h1>

		<p class="text-xl md:text-2xl text-text-secondary font-medium mb-6" data-animate-item>
			Full-Stack Developer
		</p>

		<p class="text-lg text-text-secondary max-w-2xl mb-6" data-animate-item>
			Progetto e sviluppo applicazioni web custom ad alte prestazioni. Traduco logiche di
			business complesse in codice solido e architetture cloud scalabili.
		</p>

		<div class="flex items-center gap-5 mb-8" data-animate-item>
			{
				socials.map((social) => (
					<a
						href={social.href}
						target="_blank"
						rel="noopener noreferrer"
						class="flex items-center gap-2 text-sm text-text-secondary hover:text-text-primary transition-colors duration-150"
					>
						<svg viewBox="0 0 24 24" class="w-4 h-4" fill="currentColor" aria-hidden="true">
							<path d={social.icon} />
						</svg>
						{social.label}
					</a>
				))
			}
		</div>

		<div class="flex flex-wrap gap-2 mb-10" data-animate-item>
			{
				stack.map((item) => (
					<span
						class="font-mono text-sm rounded-sm px-2 py-1 border"
						style={`border-color:${item.color}; color:${item.color}`}
					>
						{item.name}
					</span>
				))
			}
		</div>

		<div class="flex flex-wrap gap-4" data-animate-item>
			<a
				href="/cv.pdf"
				download
				class="bg-accent text-bg px-5 py-2.5 rounded-md font-medium hover:bg-accent-hover transition-colors duration-150"
			>
				Scarica CV (PDF)
			</a>
			<a
				href="#progetti"
				class="border border-border px-5 py-2.5 rounded-md font-medium hover:border-border-strong transition-colors duration-150"
			>
				Casi di Studio
			</a>
		</div>
	</div>
</section>
