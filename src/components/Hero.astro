---
import { siLaravel, siReact, siTypescript, siTailwindcss, siExpo, siMysql, siDocker, siCloudflare, siGit, siLinux, siPostman, siClaudecode, siN8n, siApache, siNginx, siPostgresql, siPhp } from 'simple-icons';
import HeroBackground from './HeroBackground.astro';

// Generic cloud glyph — AWS's  (Amazon requests it stay out),
// so we pair their brand orange with a neutral cloud icon inown mark isn't in simple-iconsstead of a look-alike logo.
const cloudIcon = 'M19 18H6.5a4.5 4.5 0 0 1-.4-8.98 5.5 5.5 0 0 1 10.6-2.31A4.5 4.5 0 0 1 19 18Z';

// Generic ">_" prompt glyph — Codex has no standalone logo in simple-icons.
const terminalIcon = 'M8 5 14 12 8 19 6 17 10 12 6 7Z M16 17H20V19H16Z';

const stackCol1 = [
	{ name: 'PHP', color: `#${siPhp.hex}`, icon: siPhp.path },
	{ name: 'Laravel', color: `#${siLaravel.hex}`, icon: siLaravel.path },
	{ name: 'React', color: `#${siReact.hex}`, icon: siReact.path },
	{ name: 'TypeScript', color: `#${siTypescript.hex}`, icon: siTypescript.path },
	{ name: 'Tailwind', color: `#${siTailwindcss.hex}`, icon: siTailwindcss.path },
];

const stackCol2 = [
	{ name: 'React Native', color: `#${siReact.hex}`, icon: siReact.path },
	{ name: 'Expo', color: 'var(--color-text-primary)', icon: siExpo.path },
	{ name: 'Apache', color: `#${siApache.hex}`, icon: siApache.path },
	{ name: 'Nginx', color: `#${siNginx.hex}`, icon: siNginx.path },
	{ name: 'Docker', color: `#${siDocker.hex}`, icon: siDocker.path },
];

const stackCol3 = [
	{ name: 'MySQL', color: `#${siMysql.hex}`, icon: siMysql.path },
	{ name: 'PostgreSQL', color: `#${siPostgresql.hex}`, icon: siPostgresql.path },
	{ name: 'Postman', color: `#${siPostman.hex}`, icon: siPostman.path },
	{ name: 'AWS', color: '#FF9900', icon: cloudIcon },
	{ name: 'Cloudflare', color: `#${siCloudflare.hex}`, icon: siCloudflare.path },
];

const stackCol4 = [
	{ name: 'Git', color: `#${siGit.hex}`, icon: siGit.path },
	{ name: 'Linux', color: `#${siLinux.hex}`, icon: siLinux.path },
	{ name: 'Claude Code', color: `#${siClaudecode.hex}`, icon: siClaudecode.path },
	{ name: 'Codex', color: 'var(--color-text-secondary)', icon: terminalIcon },
	{ name: 'n8n', color: `#${siN8n.hex}`, icon: siN8n.path },
];

const stackColumns = [stackCol1, stackCol2, stackCol3, stackCol4];

const socials = [
	{
		label: 'GitHub',
		href: 'https://github.com/alessiomicci',
		icon: 'M12 .5C5.73.5.5 5.73.5 12c0 5.09 3.29 9.4 7.86 10.93.57.1.78-.25.78-.55 0-.27-.01-1.17-.02-2.12-3.2.7-3.88-1.36-3.88-1.36-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.71.08-.71 1.17.08 1.78 1.2 1.78 1.2 1.03 1.77 2.71 1.26 3.37.96.1-.75.4-1.26.73-1.55-2.55-.29-5.23-1.28-5.23-5.68 0-1.25.45-2.28 1.19-3.08-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11.1 11.1 0 0 1 5.79 0c2.2-1.49 3.17-1.18 3.17-1.18.64 1.59.24 2.76.12 3.05.74.8 1.18 1.83 1.18 3.08 0 4.41-2.69 5.38-5.25 5.67.41.36.78 1.07.78 2.15 0 1.55-.01 2.8-.01 3.18 0 .3.2.66.79.55A10.52 10.52 0 0 0 23.5 12C23.5 5.73 18.27.5 12 .5Z',
	},
	{
		label: 'LinkedIn',
		href: 'https://www.linkedin.com/in/alessio-micci/',
		icon: 'M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.03-1.85-3.03-1.85 0-2.14 1.45-2.14 2.94v5.66H9.34V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.38-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.07 2.07 0 1 1 0-4.13 2.07 2.07 0 0 1 0 4.13ZM7.12 20.45H3.56V9h3.56v11.45Z',
	},
];
---

<section class="relative overflow-hidden w-full min-h-[85vh] flex flex-col justify-center px-6 py-24">
	<HeroBackground />

	<div class="relative z-10 max-w-3xl mx-auto w-full">
		<h1 class="text-4xl md:text-6xl font-semibold mb-2" data-animate-item>Alessio Micci</h1>

		<p class="text-xl md:text-2xl text-text-secondary font-medium mb-6" data-animate-item>Full-Stack Software Engineer · AI-Native Development</p>

		<p class="text-lg text-text-secondary max-w-2xl mb-6" data-animate-item>I turn complex business requirements into reliable software. My current approach combines full-stack engineering with an established AI-native workflow: defining architecture and shared project context, guiding coding agents through implementation, and validating the results.</p>

		<div class="flex items-center gap-5 mb-10" data-animate-item>
			{
				socials.map((social) => (
					<a href={social.href} target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 text-sm text-text-secondary hover:text-text-primary transition-colors duration-150">
						<svg viewBox="0 0 24 24" class="w-4 h-4" fill="currentColor" aria-hidden="true">
							<path d={social.icon} />
						</svg>
						{social.label}
					</a>
				))
			}
		</div>

		<div class="flex flex-wrap gap-x-8 gap-y-2 max-w-2xl mb-14" data-animate-item>
			{
				stackColumns.map((column) => (
					<div class="flex flex-col gap-3">
						{column.map((item) => (
							<span class="inline-flex items-center gap-1.5 font-mono text-sm" style={`color:${item.color}`}>
								<svg viewBox="0 0 24 24" class="w-3.5 h-3.5 shrink-0" fill="currentColor" aria-hidden="true">
									<path d={item.icon} />
								</svg>
								{item.name}
							</span>
						))}
					</div>
				))
			}
		</div>

		<div class="flex flex-wrap gap-4" data-animate-item>
			<a href="mailto:alessio.micci.41@gmail.com" class="bg-accent text-bg px-5 py-2.5 rounded-md font-medium hover:bg-accent-hover transition-colors duration-150"> Contact Me </a>
			<a href="#work" class="border border-border px-5 py-2.5 rounded-md font-medium hover:border-border-strong transition-colors duration-150"> Selected Work </a>
			<a href="#method" class="border border-border px-5 py-2.5 rounded-md font-medium hover:border-border-strong transition-colors duration-150"> How I Build </a>
		</div>
	</div>
</section>
